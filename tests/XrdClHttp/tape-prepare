#!/usr/bin/env python3

import json
import os
import posixpath
import shutil
import sys
import tempfile
import time
from pathlib import Path, PurePosixPath


def fail(message):
    print(f"tape-prepare: {message}", file=sys.stderr)
    return 1


def resolve_path(root, value):
    if not value.startswith("/") or "\0" in value:
        raise ValueError("file paths must be absolute")

    normalized = posixpath.normpath(value)
    relative = PurePosixPath(normalized).relative_to("/")
    resolved = root.joinpath(*relative.parts).resolve(strict=False)
    if root != resolved and root not in resolved.parents:
        raise ValueError("file path escapes the test storage root")
    return normalized, resolved


def stage(root, request_id, paths):
    created_at = int(time.time())
    request = {
        "id": request_id,
        "createdAt": created_at,
        "startedAt": created_at,
        "files": [],
    }

    archive_root = (root / "archive").resolve()
    disk_root = (root / "disk").resolve()
    for value in paths:
        started_at = int(time.time())
        entry = {"path": value, "startedAt": started_at}
        try:
            normalized, archive_path = resolve_path(archive_root, value)
            _, disk_path = resolve_path(disk_root, normalized)
            entry["path"] = normalized
            if not archive_path.is_file():
                raise ValueError("file is not stored on tape")
            if archive_path.stat().st_size == 0:
                raise ValueError(
                    "zero-length files cannot be staged from tape"
                )
            disk_path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(archive_path, disk_path)
            entry["state"] = "COMPLETED"
        except (OSError, ValueError) as error:
            entry["state"] = "FAILED"
            entry["error"] = str(error)
        entry["finishedAt"] = int(time.time())
        request["files"].append(entry)

    request["completedAt"] = int(time.time())
    requests_root = root / "requests"
    requests_root.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w", dir=requests_root, prefix=request_id + ".", delete=False
    ) as output:
        json.dump(request, output, separators=(",", ":"))
        temporary = Path(output.name)
    os.replace(temporary, requests_root / (request_id + ".json"))
    return 0


def main():
    root_value = os.environ.get("XRDPREP_TEST_ROOT")
    if not root_value:
        return fail("XRDPREP_TEST_ROOT is not set")

    try:
        separator = sys.argv.index("--")
    except ValueError:
        return fail("missing argument separator")
    arguments = sys.argv[separator + 1:]
    if len(arguments) < 3:
        return fail("missing request ID, operation, or paths")

    request_id, operation, *paths = arguments
    if (
        len(request_id) > 127
        or request_id in ("", ".", "..")
        or "/" in request_id
        or "\\" in request_id
        or any(ord(character) < 32 for character in request_id)
    ):
        return fail("unsafe request ID")
    if operation != "stage":
        return fail(f"unsupported operation: {operation}")

    try:
        return stage(Path(root_value).resolve(), request_id, paths)
    except OSError as error:
        return fail(str(error))


if __name__ == "__main__":
    sys.exit(main())
